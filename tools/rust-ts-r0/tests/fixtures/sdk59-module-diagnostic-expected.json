{
  "typescript_version": "5.9.3",
  "scope": "FROZEN_PUBLIC_MODULE_DIAGNOSTIC_COMPATIBILITY_NOT_R0",
  "cases": [
    {
      "id": "PUBLIC-C1-SDK59-parent-cycle-mixed-order",
      "files": {
        "/project/main.ts": "export const publicValue = 1;\n",
        "/project/tsconfig.json": "{\"extends\":\"./base.json\",\"compilerOptions\":{\"target\":\"ES2022\",\"module\":\"ESNext\",\"moduleResolution\":\"Bundler\",\"skipLibCheck\":true,\"noEmit\":true},\"files\":[\"main.ts\"]}\n",
        "/project/base.json": "{\"extends\":\"./base.json\",\"compilerOptions\":{\"module\":\"BadModule\",\"target\":\"ES2025\"}}\n"
      },
      "source_path": "/project/main.ts",
      "repository_root": "/project",
      "expected_reasons": [
        "SOURCE_CONFIGURATION_INVALID:6046:Argument for '--module' option must be: 'none', 'commonjs', 'amd', 'system', 'umd', 'es6', 'es2015', 'es2020', 'es2022', 'esnext', 'node16', 'node18', 'node20', 'nodenext', 'preserve'.",
        "SOURCE_CONFIGURATION_INVALID:6046:Argument for '--target' option must be: 'es5', 'es6', 'es2015', 'es2016', 'es2017', 'es2018', 'es2019', 'es2020', 'es2021', 'es2022', 'es2023', 'es2024', 'esnext'.",
        "SOURCE_CONFIGURATION_INVALID:18000:Circularity detected while resolving configuration: /project -> /project/base.json -> /project/base.json"
      ],
      "expected_with_source_reasons": [
        "SOURCE_CONFIGURATION_INVALID:6046:Argument for '--module' option must be: 'none', 'commonjs', 'amd', 'system', 'umd', 'es6', 'es2015', 'es2020', 'es2022', 'esnext', 'node16', 'node18', 'node20', 'nodenext', 'preserve'.",
        "SOURCE_CONFIGURATION_INVALID:6046:Argument for '--target' option must be: 'es5', 'es6', 'es2015', 'es2016', 'es2017', 'es2018', 'es2019', 'es2020', 'es2021', 'es2022', 'es2023', 'es2024', 'esnext'.",
        "SOURCE_CONFIGURATION_INVALID:18000:Circularity detected while resolving configuration: /project -> /project/base.json -> /project/base.json"
      ]
    },
