===== ACTUAL_EXECUTION_SOURCE_CRYPTO_AND_COMBINATION_PROOF RAW_SHA256=7dc706d7f47baa01d8fb55b1bd1b272bfc566a4bc4e168da50ebda231ff4c08a RAW_BYTES=6650 [VERBATIM] =====
"""Whole-script public fixture controls; no native invocation or admission."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

HERE=Path(__file__).resolve().parent
ROOT=HERE/'combination-tests'
ROOT.mkdir()
SCRIPT=HERE/'combine_native_evidence.py'
GRAPH=HERE.parent/'semctx-public38-native-refusal-readback/FULL-NATIVE-READBACK.json'
def sha(raw):return hashlib.sha256(raw).hexdigest()
def pin(path):
    raw=path.read_bytes()
    return {'path':str(path),'sha256':sha(raw),'bytes':len(raw)}
script_pin=pin(SCRIPT)
original_crypto=json.loads((HERE/'ACTUAL-COLLECTIONS.json').read_bytes())
source_files=[SCRIPT,GRAPH,HERE/'epoch.json',HERE/'SOURCE-ADMISSION.json',HERE/'ACTUAL-COLLECTIONS.json']
for lane,archive in [('macos',HERE/'acquisition-macos'),('linux',HERE/'acquisition-linux-public')]:
    source_files += [archive/'policy.json',archive/'attempts/public38-native-once/result.json',
                     Path(original_crypto['lanes'][lane]['verification_path'])]
original_before={str(path):pin(path) for path in source_files}
records=[]
environment={'PATH':os.environ['PATH'],'LC_ALL':'C','PYTHONDONTWRITEBYTECODE':'1'}
for case,diagnostic in [('positive',None),('signature-exit','historical signature check not positive'),
                        ('graph-manifest','readback identities differ')]:
    base=ROOT/case
    fixture=base/'public-proof'
    fixture.mkdir(parents=True)
    graph_dir=base/'semctx-public38-native-refusal-readback'
    graph_dir.mkdir()
    shutil.copy2(SCRIPT,fixture/SCRIPT.name)
    shutil.copy2(GRAPH,graph_dir/GRAPH.name)
    for name in ('epoch.json','SOURCE-ADMISSION.json'):
        shutil.copy2(HERE/name,fixture/name)
    crypto=json.loads((HERE/'ACTUAL-COLLECTIONS.json').read_bytes())
    inputs=[fixture/SCRIPT.name,graph_dir/GRAPH.name,fixture/'epoch.json',fixture/'SOURCE-ADMISSION.json']
    modified=[]
    for lane,original in [('macos',HERE/'acquisition-macos'),('linux',HERE/'acquisition-linux-public')]:
        archive=fixture/('acquisition-macos' if lane=='macos' else 'acquisition-linux-public')
        (archive/'attempts/public38-native-once').mkdir(parents=True)
        for relative in ('policy.json','attempts/public38-native-once/result.json'):
            shutil.copy2(original/relative,archive/relative)
            inputs.append(archive/relative)
        verification=fixture/(lane+'-signature-public.json')
        original_raw=Path(crypto['lanes'][lane]['verification_path']).read_bytes()
        verification.write_bytes(original_raw)
        if case=='signature-exit' and lane=='macos':
            body=json.loads(original_raw)
            body['historical_signature']['exit']=1
            verification.write_text(json.dumps(body,indent=2)+'\n')
            modified.append({'path':str(verification),'before_content':original_raw.decode(),
                'after_content':verification.read_text(),'before_sha256':sha(original_raw),
                'after_sha256':sha(verification.read_bytes()),
                'semantic_change':'Historical signature exit becomes1; fixture verification SHA updated so loadpin succeeds.'})
        crypto['lanes'][lane]['verification_path']=str(verification)
        crypto['lanes'][lane]['verification_sha256']=sha(verification.read_bytes())
        inputs.append(verification)
    (fixture/'ACTUAL-COLLECTIONS.json').write_text(json.dumps(crypto,indent=2)+'\n')
    inputs.append(fixture/'ACTUAL-COLLECTIONS.json')
    if case=='graph-manifest':
        path=graph_dir/GRAPH.name
        before=path.read_bytes();body=json.loads(before)
        body['lanes']['macos']['raw_readback']['manifest_sha256']='0'*64
        path.write_text(json.dumps(body,indent=2)+'\n')
        modified.append({'path':str(path),'before_content':before.decode(),'after_content':path.read_text(),
            'before_sha256':sha(before),'after_sha256':sha(path.read_bytes()),
            'semantic_change':'Only macos raw manifest identity differs; complete graph counts remain positive.'})
    before={str(path):pin(path) for path in inputs}
    require_script=pin(fixture/SCRIPT.name)
    assert require_script['sha256']==script_pin['sha256']
    argv=[sys.executable,'-I','-B','-X','pycache_prefix='+str(base/'.empty-cache'),str(fixture/SCRIPT.name)]
    result=subprocess.run(argv,cwd=fixture,env=environment,capture_output=True,check=False,timeout=20)
    for stream in ('stdout','stderr'):
        (base/(stream+'.raw')).write_bytes(getattr(result,stream))
    after={str(path):pin(path) for path in inputs}
    assert before==after
    out=fixture/'verified-native'
    if diagnostic is None:
        assert result.returncode==0,result.stderr
        summary=json.loads(result.stdout)
        assert summary['state']=='COMBINED_NATIVE_PUBLIC38_PASS'
        assert len(summary['lanes'])==2
        for lane in ('macos','linux'):
            assert json.loads((out/(lane+'.readback.json')).read_bytes())['state']=='PASS'
        assert (out/'native-evidence.json').is_file()
    else:
        assert result.returncode!=0
        assert ('ValueError: '+diagnostic).encode() in result.stderr,result.stderr
        assert not list(out.glob('*.source.json')) and not list(out.glob('*.readback.json'))
        assert not (out/'native-evidence.json').exists()
    row={'fixture_label':'ISOLATED PUBLIC COMBINATION CONTROL '+case,'argv':argv,'cwd':str(fixture),
         'environment':environment,'exit':result.returncode,'expected_diagnostic':diagnostic,
         'script_sha256':require_script['sha256'],'inputs_before':before,'inputs_after':after,
         'modified_inputs':modified,'stdout_sha256':sha(result.stdout),'stderr_sha256':sha(result.stderr),
         'pass_outputs_absent':not (out/'native-evidence.json').exists()}
    (base/'RESULT.json').write_text(json.dumps(row,indent=2)+'\n')
    records.append(row)
assert original_before=={str(path):pin(path) for path in source_files}
record={'cases':records,'original_inputs_before':original_before,
        'original_inputs_after':{str(path):pin(path) for path in source_files},'script':script_pin,
        'producer':pin(Path(__file__)),'scope':'Byte-exact whole combine script in fresh isolated public fixtures. Original attempt identity strings preserved. No helper-only test, source edit, product/grant/private-key operation or original output overwrite.'}
(ROOT/'RESULT.json').write_text(json.dumps(record,indent=2)+'\n')
print(json.dumps({'cases':3,'positive_exit':records[0]['exit'],
    'negative_exits':[r['exit'] for r in records[1:]],
    'result_sha256':sha((ROOT/'RESULT.json').read_bytes()),'script_sha256':script_pin['sha256']}))


