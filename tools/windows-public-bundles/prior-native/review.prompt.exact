===== PINNED_PURE_READER RAW_SHA256=b7ced1193ab7ee92dfe6913c5b6d2b328b3952006ebd576d9c34831bf319080a RAW_BYTES=14441 [VERBATIM] =====
"""Read a completed P14 native attempt on its original host, with no process execution."""
import argparse
import importlib.abc
import importlib.util
import json
import os
from pathlib import Path
import sys

PKG = Path("tools/rust-ts-r0/qualification/public38-current04")
ADJUDICATION_SHA256 = "0ecb0c8e58b56b3c6a3055ae13700dbac04f2c2ed1987792ec09c0d6b6000c26"


def need(condition, message):
    if not condition:
        raise ValueError(message)


def load(path):
    path = Path(path)
    need(path.is_absolute() and path.resolve(strict=True) == path and path.is_file(), "noncanonical input file")
    need(path.stat().st_size <= 67_108_864, "input exceeds record cap")
    raw = path.read_bytes()
    return raw


def object_bytes(raw):
    def unique(pairs):
        value = {}
        for key, item in pairs:
            need(key not in value, "duplicate JSON key")
            value[key] = item
        return value
    return json.loads(raw, object_pairs_hook=unique,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError("nonfinite JSON")))


def guard(event, args):
    if event in {"subprocess.Popen", "os.system", "os.exec", "os.posix_spawn", "os.posix_spawnp"}:
        raise RuntimeError("native readback cannot execute a process")
    if event == "open":
        mode, flags = args[1], args[2]
        need(not (isinstance(mode, str) and any(c in mode for c in "wax+")), "native readback cannot write")
        write_flags = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
        need(not (isinstance(flags, int) and flags & write_flags), "native readback cannot open writable files")


class PinnedSourceLoader(importlib.abc.Loader):
    def __init__(self, path, raw):
        self.path, self.raw = path, raw

    def create_module(self, spec):
        return None

    def exec_module(self, module):
        module.__file__ = str(self.path)
        module.__cached__ = None
        exec(compile(self.raw, str(self.path), "exec", dont_inherit=True), module.__dict__)


class PinnedSourceFinder(importlib.abc.MetaPathFinder):
    def __init__(self, sources):
        self.sources = sources

    def find_spec(self, fullname, path=None, target=None):
        if fullname in self.sources:
            source, raw = self.sources[fullname]
            return importlib.util.spec_from_loader(fullname, PinnedSourceLoader(source, raw))
        return None


def verified_sources(source_root, package, epoch, sha):
    states = {entry["path"]: entry for entry in epoch["subject"]["path_states"]}
    manifest_name = (PKG / "component-sources.json").as_posix()
    need(manifest_name in states, "component map is not bound by the source epoch")
    source_pins = {}
    for name, state in states.items():
        need(state["kind"] == "file", "source binding contains unsupported state")
        actual = load(source_root / name)
        need("sha256:" + sha(actual) == state["digest"], "source differs from candidate epoch")
        source_pins[str(source_root / name)] = sha(actual)
    mapping = object_bytes(load(package / "component-sources.json"))
    need(mapping["source_head"] == "04b83a5f394431e1dcca533889f6c02e32d02a0d",
         "component map source head differs")
    modules = {}
    for name, pin in mapping["sources"].items():
        relative = Path(name)
        need(not relative.is_absolute() and ".." not in relative.parts and str(relative) == name,
             "component path escapes the pinned package")
        path = package / relative
        actual = load(path)
        need(type(pin["bytes"]) is int and pin["bytes"] >= 0
             and (len(actual), sha(actual)) == (pin["bytes"], pin["sha256"]),
             "component content differs from pinned source map")
        source_pins[str(path)] = sha(actual)
        if relative.parent == Path(".") and relative.suffix == ".py":
            modules[relative.stem] = (path, actual)
    local = Path(__file__).resolve().parent / "frozen_adjudication.py"
    actual = load(local)
    need(sha(actual) == ADJUDICATION_SHA256, "local frozen adjudication helper differs")
    source_pins[str(local)] = sha(actual)
    modules["frozen_adjudication"] = (local, actual)
    need(all(name not in sys.modules for name in modules), "candidate module was imported before source pin validation")
    return source_pins, modules


def main(args):
    import hashlib
    sha = lambda raw: hashlib.sha256(raw).hexdigest()
    canonical = lambda value: json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    package = args.source_root.resolve(strict=True) / PKG
    sys.dont_write_bytecode = True
    sys.addaudithook(guard)
    raw = load(args.epoch)
    need(sha(raw) == args.epoch_sha256, "epoch pin differs")
    epoch = object_bytes(raw)
    need("sha256:" + sha(canonical(epoch["subject"])) == epoch["subject_digest"], "epoch canonical subject differs")
    source_pins, modules_source = verified_sources(args.source_root, package, epoch, sha)
    sys.meta_path.insert(0, PinnedSourceFinder(modules_source))
    import runner_core as core
    import native_evidence as evidence
    from native_adapter import DisabledNativeAdapter
    from frozen_adjudication import verify_adjudication
    modules = {str(package / name): sha(load(package / name)) for name in
               ("runner_core.py", "native_evidence.py", "native_adapter.py", "public38_env.py")}
    plan = DisabledNativeAdapter(package / "inputs" / (args.lane + ".json"))
    attempt = args.attempt.resolve(strict=True)
    reservation_raw = load(attempt / "attempt.json")
    reserved = object_bytes(reservation_raw)
    request, admission = reserved["request"], reserved["admission"]
    need(reserved["state"] == "RESERVED_ONCE" and reserved["manifest_sha256"] == plan.manifest_sha256,
         "attempt reservation differs")
    need(request["attempt_path"] == str(attempt) and request["manifest_sha256"] == plan.manifest_sha256
         and request["source_head"] == plan.plan["source_head"] and request["lane"] == args.lane,
         "request differs from frozen attempt")
    runtime = core.RuntimeIdentity.current()
    need(request["runtime"] == {"lane": runtime.lane, "architecture": runtime.architecture,
                               "provenance": runtime.provenance} and runtime.lane == args.lane,
         "reader must run on original native host")
    request_sha = sha(canonical(request))
    need(admission["observation_mode"] == "native" and admission["request_sha256"] == request_sha,
         "native admission request binding differs")
    for value in (request, admission):
        need(type(value["phase_budget"]) is int and value["phase_budget"] == 19
             and type(value["attempts_per_operation"]) is int and value["attempts_per_operation"] == 1,
             "native attempt budget differs")
    grant_raw = load(args.grant)
    need(sha(grant_raw) == args.grant_sha256, "signed envelope hash differs from independent pin")
    envelope, consumed = object_bytes(grant_raw), object_bytes(load(args.consumed))
    payload = envelope["payload"]
    need(isinstance(envelope["signature"], str) and bool(envelope["signature"]), "signature absent")
    need(payload["request"] == request and payload["request_sha256"] == request_sha
         and payload["controller_subject_digest"] == epoch["subject_digest"]
         and payload["observation_mode"] == "native" and payload["issuer"] == admission["authenticated_by"],
         "signed payload differs from frozen request/source")
    need(consumed == {"envelope_sha256": args.grant_sha256, "policy_sha256": payload["policy_sha256"],
                      "request_sha256": request_sha}, "consumed record differs")
    need(admission["evidence_sha256"] == args.grant_sha256, "admission evidence is not the consumed envelope")
    journal_raw = load(attempt / "journal.jsonl")
    entries = [core.OperationReceipt(**object_bytes(line)) for line in journal_raw.splitlines()]
    need(len(entries) == 38 and tuple(entry.operation_id for entry in entries) == plan.order,
         "completed journal does not contain the exact 38 operations")
    core.check_receipts(entries)
    _, records, captures = evidence._prefix(plan, entries[:-1], entries[-1].operation_id, "native")
    last = entries[-1]
    row = plan.rows[last.operation_id]
    owner = evidence._operation_directory(attempt, 37, row)
    raw = evidence._read(Path(last.receipt_path), owner)
    final = object_bytes(raw)
    need(sha(raw) == last.receipt_sha256 and final["operation_id"] == row["id"]
         and final["operation_sha256"] == sha(canonical(row)) and final["observation_mode"] == "native",
         "final receipt differs")
    artifacts = {pin["logical_path"]: pin for record in records.values() for pin in record["outputs"]}
    need(final["dynamic_inputs"] == [artifacts[name] for name in plan.explicit[row["id"]]],
         "final input lineage differs")
    need([pin["logical_path"] for pin in final["outputs"]] == list(plan.outputs[row["id"]]),
         "final output inventory differs")
    for pin in final["outputs"]:
        core.check_pin(core.ArtifactPin(**pin))
    metadata = final["evidence"]["capture"]
    captures[row["id"]] = evidence._capture(row, metadata["directory"], owner, metadata)
    records[row["id"]] = final
    for identifier, record in records.items():
        if plan.rows[identifier]["kind"] == "barrier":
            continue
        directory = Path(record["evidence"]["capture"]["directory"])
        transport = {name: load(directory / name) for name in (
            "native-job.json", "operation-spec.json", "reservation.json", "pins-after.json",
            "native-result.json", "native-call.json")}
        job, spec, reservation, after, result, call = map(object_bytes, transport.values())
        need(job["capture"] == spec and job["request_sha256"] == request_sha
             and job["observation_mode"] == "native", "native job binding differs")
        need(reservation == {"operation_id": identifier, "kind": plan.rows[identifier]["kind"],
                             "spec_sha256": sha(transport["operation-spec.json"]),
                             "worker_sha256": call["worker_sha256"]}, "native reservation differs")
        need(after == spec["pins"], "postflight pin inventory differs")
        for pin in after:
            data = load(pin["path"])
            need(type(pin["bytes"]) is int and (len(data), sha(data)) == (pin["bytes"], pin["sha256"]),
                 "postflight input bytes differ")
        for value in (call, result):
            need(value["job_sha256"] == sha(transport["native-job.json"])
