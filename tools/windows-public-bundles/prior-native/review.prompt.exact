"""Frozen, mode-neutral adjudication schema and stdout verification."""

import hashlib

import json

ORACLE_SHA256 = '7d43015b371ef21ab1e8ecc05faa0de8c6d5419537586fd2678f1e47719657cf'

PUBLIC6_CASES = (
    ('PUBLIC-01-value-namespace', ('syntax-valid', 'TS runtime value declaration is function',
        'historical raw extraction resolves real function', 'historical qualified assembly ambiguity preserved')),
    ('PUBLIC-02-sdk-origin', ('syntax-valid', 'actual independent SDK origin', 'source-local semantic predicate')),
    ('PUBLIC-03-sdk-opaque-argument', ('syntax-valid', 'actual independent SDK origin', 'source-local semantic predicate')),
    ('PUBLIC-04-sdk-timer-category', ('syntax-valid', 'immutable alias has actual SDK target', 'named actual timer boundary')),
    ('PUBLIC-05-broad-declaration-scope', ('syntax-valid', 'source-local root is separate and insufficient',
        'required broad caller actually observes named reason')),
    ('PUBLIC-06-reached-body-scope', ('syntax-valid', 'source-local root is separate and insufficient',
        'required broad caller actually observes named reason')),
)

def need(condition, message):
    if not condition:
        raise ValueError(message)

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def obj(raw):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            need(key not in result, 'duplicate archive JSON key')
            result[key] = value
        return result
    value = json.loads(raw, object_pairs_hook=unique)
    need(isinstance(value, dict), 'archive record is not an object')
    return value

def verify_adjudication(raw, stdout, lane):
    """Check the frozen nineteen assertion slots, actual aggregate and stdout binding."""
    value = obj(raw)
    need(value.get('schema') == 1 and value.get('state') == 'ACTUAL_PUBLIC_DEV_ADJUDICATION'
         and value.get('lane') == lane and value.get('source_head') == '04b83a5f394431e1dcca533889f6c02e32d02a0d'
         and value.get('qualification_credit') == 0 and value.get('frozen_oracle_sha256') == ORACLE_SHA256,
         'adjudication identity or frozen oracle differs')
    cases = value.get('cases')
    need(isinstance(cases, list) and len(cases) == 6, 'adjudication case inventory differs')
    counts = {'PASS': 0, 'NONPASS': 0, 'GAP': 0}
    for case, (identifier, labels) in zip(cases, PUBLIC6_CASES, strict=True):
        need(isinstance(case, dict) and case.get('witness') == identifier, 'adjudication witness order differs')
        rows = case.get('assertions')
        need(isinstance(rows, list) and len(rows) == len(labels), 'adjudication per-case denominator differs')
        for row, label in zip(rows, labels, strict=True):
            need(isinstance(row, dict) and row.get('assertion') == label and row.get('state') in counts
                 and isinstance(row.get('evidence'), str) and bool(row['evidence']),
                 'adjudication frozen assertion schema differs')
            counts[row['state']] += 1
    need(sum(counts.values()) == 19 and value.get('counts') == counts
         and all(type(count) is int for count in value['counts'].values()), 'adjudication aggregate differs')
    need(obj(stdout) == {'lane': lane, 'counts': counts, 'sha256': sha(raw), 'qualification_credit': 0},
         'adjudication stdout hash or counts differ')
    return value


