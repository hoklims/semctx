import hashlib
import io
import json
import os
from pathlib import Path
import stat
import tarfile
import tempfile

ROOT=Path('/tmp/public38-p14-owner.Y0u1wv/acquisition-linux-p15')
assert ROOT.resolve(strict=True)==ROOT
OUT=Path(tempfile.mkdtemp(prefix='public38-p15-public-retention.'))
def sha(raw):return hashlib.sha256(raw).hexdigest()
def files():
    found={}
    for directory,dirs,names in os.walk(ROOT,followlinks=False):
        dirs[:]=[name for name in dirs if name!='authority']
        for name in dirs:
            path=Path(directory)/name
            assert stat.S_ISDIR(path.lstat().st_mode) and not path.is_symlink(),path
        for name in names:
            if name=='private-key.pem':
                continue
            path=Path(directory)/name
            before=path.lstat()
            assert stat.S_ISREG(before.st_mode) and not path.is_symlink(),path
            raw=path.read_bytes()
            after=path.lstat()
            assert (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns)==(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns)
            found[str(path.relative_to(ROOT))]={'sha256':sha(raw),'bytes':len(raw)}
    return found
before=files()
archive=OUT/'acquisition.tar'
with tarfile.open(archive,'w') as tar:
    for name,pin in sorted(before.items()):
        raw=(ROOT/name).read_bytes()
        assert sha(raw)==pin['sha256']
        member=tarfile.TarInfo(name);member.mode=0o600;member.size=len(raw)
        tar.addfile(member,io.BytesIO(raw))
after=files()
assert before==after
record={'original_root':str(ROOT),'archive':str(archive),'archive_sha256':sha(archive.read_bytes()),
    'files_before':before,'files_after':after,'file_count':len(before),
    'total_bytes':sum(p['bytes'] for p in before.values()),
    'excluded_names':['authority','private-key.pem'],'scope':'Current public acquisition only. No traversal of the reused authority root; no private key read or copy; every retained entry regular and non-symlink.'}
(OUT/'inventory.json').write_text(json.dumps(record,indent=2)+'\n')
print(json.dumps({'directory':str(OUT),'file_count':len(before),'total_bytes':record['total_bytes']}))


