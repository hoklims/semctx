                "contractSha256":checked["publicPins"]["holdoutContract"]["sha256"],"receiptSha256":checked["publicPins"]["receipt"]["sha256"],
                "candidateFreezePath":str(Path(roots[lane])/"candidate-freeze.json"),"candidateFreezeSha256":sha(common),"candidateSourceCommit":HEAD,
                "platformFreezePaths":{host:str(Path(roots[host])/f"platform-{host}.json") for host in roots},
                "runtimeSha256":{host:PLAN["runtimesObserved"][host]["sha256"] for host in roots},
                "privateCommitments":checked["privateCommitmentsFromPublicReceipt"],
                "nativePublic38Review":{"sha256":args.review_sha256},"nativePublic38EvidenceSha256":args.native_evidence_sha256,
                "nativePublic38Commitments":commitments,"invocationContractSha256":checked["publicPins"]["invocationContract"]["sha256"],
                "independentPreparationReviewSha256":checked["publicPins"]["preparationReview"]["sha256"]}
