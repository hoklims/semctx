 request=policy['request_template'];require(request['lane']==lane and request['attempt_path']==original_attempt and request['source_head']==HEAD and request['manifest_sha256']==raw['manifest_sha256'],'owner request differs')
 result_path=archive/'attempts/public38-native-once/result.json';result_pin=pin(result_path)
 require(result_pin['sha256']==verification['result']['sha256']==extra['result_pin']['sha256'],'archive/original result bytes differ')
 result=loadpin(result_pin);require(result==verification['native_result'],'raw result differs from signature collection record')
 require(result=={'state':'ALL_SCHEDULED_OPERATIONS_ACCEPTED','observation_mode':'native','manifest_sha256':raw['manifest_sha256'],'operations':38,'phase_operations':19,'candidate_queries':19,'qualification_credit':0,'dynamic_artifacts':65},'raw completion result differs')
 common={'schema':1,'lane':lane,'source_head':HEAD,'controller_subject_digest':subject,'manifest_sha256':raw['manifest_sha256'],'attempt':original_attempt,'result_sha256':result_pin['sha256']}
 source={**common,'state':'VERIFIED_SOURCE_AND_AUTHORIZATION_BINDINGS','crypto_evidence':evidence,'policy':pin(archive/'policy.json'),'source_admission':pin(HERE/'SOURCE-ADMISSION.json'),'epoch':pin(HERE/'epoch.json'),'signature_verification':pin(c['verification_path']),'native_graph_record':pin(GRAPH),'original_host_verified':True,'qualification_credit':0}
 combined={**common,'state':'PASS','observation_mode':'native','operations':38,'captures':37,'env4':'PASS','public6_summary':'PASS','public6_assertion_counts':raw['public6_assertion_counts'],'crypto':{'signature_verified':True,'evidence':evidence,'historical_only_no_authorization_renewal':True},'raw_graph_readback_sha256':g['raw_output_pins']['stdout']['sha256'],'raw_graph_state_preserved':raw['state'],'qualification_credit':0}
 source_pin=write(lane+'.source.json',source);readback_pin=write(lane+'.readback.json',combined)
 lanes[lane]={'source':source_pin,'result':result_pin,'readback':readback_pin};checks.append({'lane':lane,'graph':'PASS','historical_signature':'PASS','result':'PASS','original_attempt_preserved':original_attempt,'manifest_sha256':raw['manifest_sha256']})
dto={'schema':1,'lanes':lanes};dto_pin=write('native-evidence.json',dto)
write('COMBINATION-PROVENANCE.json',{'subject_digest':subject,'product':HEAD,'script':pin(Path(__file__)),'inputs':{'graph':pin(GRAPH),'crypto':pin(HERE/'ACTUAL-COLLECTIONS.json')},'checks':checks,'output':dto_pin,'qualification_credit':0,'product_invocations':0})
