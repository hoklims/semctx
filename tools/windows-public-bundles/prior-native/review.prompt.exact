    try:
        report = main(options)
        print(json.dumps(report, indent=2))
        raise SystemExit({"PASS": 0, "NONPASS": 1, "GAP": 2}[report["state"]])
    except (OSError, ValueError, KeyError, TypeError, StopIteration) as error:
        print(json.dumps({"state": "NONPASS", "reason": str(error), "qualification_credit": 0}))
        raise SystemExit(1)


