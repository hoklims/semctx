 require(extra['source42_pins_unchanged'] is True,'source changed during readback')
 evidence=c['cryptoEvidence'];require(evidence==verification['cryptoEvidence'] and raw['grant_sha256']==evidence['grant_sha256'],'graph/crypto grant differs')
 for name,entry in raw['source_module_pins'].items():
