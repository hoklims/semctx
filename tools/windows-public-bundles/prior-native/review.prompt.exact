===== ORIGINAL_HOST_GRAPH_READBACK RAW_SHA256=fa652f8fb059b6fd1879a4fbb67176063cc07e885249b435b2bd9651941c15db RAW_BYTES=2140 [VERBATIM] =====
import pathlib,json,hashlib,sys
P=pathlib.Path; sha=lambda b:hashlib.sha256(b).hexdigest(); root=P(sys.argv[1]);attempt=P(sys.argv[2]); pkg=root/'tools/rust-ts-r0/qualification/public38-current04'
pin=lambda p:{'path':str(p),'sha256':sha(p.read_bytes()),'bytes':p.stat().st_size}
mp=json.loads((pkg/'component-sources.json').read_bytes()); source={str(pkg/k):pin(pkg/k) for k in mp['sources']};source[str(pkg/'component-sources.json')]=pin(pkg/'component-sources.json');assert len(source)==42
entries=[json.loads(x) for x in (attempt/'journal.jsonl').read_bytes().splitlines()]; records={e['operation_id']:json.loads(P(e['receipt_path']).read_bytes()) for e in entries}
env=records['barrier:ENV4']['evidence']['env4_report']; refusal=records['phase:refusal/included-nearest-verify']['evidence']['capture']['outcome'];final=records[entries[-1]['operation_id']]['evidence']['capture']['outcome'];verdict=json.loads(final['stdout'])['verify']
assert refusal['exit_code']==1 and refusal['stdout']=='' and json.loads(refusal['stderr'])=={'error':'indexed extraction rejected: UnexpectedOutcome'}
assert final['exit_code']==0 and verdict=={'exitCode':1,'stdoutBytes':0,'stderrError':'indexed extraction rejected: UnexpectedOutcome','analysisAdmissionReportPresent':False,'indexedExtractionReportPresent':False}
summarypin=next(p for r in records.values() for p in r['outputs'] if p['logical_path']=='public6/evidence/native-summary.json');summary=json.loads(P(summarypin['path']).read_bytes())
assert source=={p:pin(P(p)) for p in source}
print(json.dumps({'source42_pins_before':source,'source42_pins_unchanged':True,'result_pin':pin(attempt/'result.json'),'component_map_pin':pin(pkg/'component-sources.json'),'phase_operations':sum(e['kind']=='phase' for e in entries),'dynamic_artifacts':sum(len(r['outputs']) for r in records.values()),'env4_observations':env['observations'],'public6_phases':len(summary['phases']),'operational_refusal':{'exit_code':1,'stdout_bytes':0,'stderr_sha256':sha(refusal['stderr'].encode()),'exact_error_verified':True,'final_reader_exit_code':0,'final_reader_verify':verdict},'qualification_credit':0},indent=2))


