 g['process']=simulated_process
 positive=n['finalize'](args,checked)
 assert len(batches)==2 and len(vacancies)==2
 assert batches[0]['files']['candidate-freeze.json']==batches[1]['files']['candidate-freeze.json']
 for lane,batch in zip(('macos','linux'),batches):
  files=batch['files'];b=json.loads(files['freezeB.json']);candidate=json.loads(files['candidate-freeze.json']);platform=json.loads(files['platform-'+lane+'.json'])
  assert b['candidateFreezeSha256']==hashlib.sha256(files['candidate-freeze.json']).hexdigest()==positive['candidateFreezeSha256']
