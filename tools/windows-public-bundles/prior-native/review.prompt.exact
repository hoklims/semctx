 after={p:sha(Path(p)) for p in before};assert before==after
 record={'schema':1,'state':'PASS','argv':sys.argv,'cwd':os.getcwd(),'environment':{'python':sys.executable,'python_dont_write_bytecode':sys.dont_write_bytecode},'builder_before_after':before,'inputs_after':after,'producer_sha256':sha(Path(__file__)),'tests':results,'process_calls':calls,'private_access':False,'observer_invocations':0,'product_invocations':0}
