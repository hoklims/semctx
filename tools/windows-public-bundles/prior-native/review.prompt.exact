 def run(name,review,reviewsha,dto,dtosha,expected):
  args=types.SimpleNamespace(review_receipt=str(review),review_sha256=reviewsha,native_evidence=str(dto),native_evidence_sha256=dtosha,macos_root=str(fixtures/(name+'-macos-NO-B')),linux_root='/tmp/SYNTHETIC-'+name+'-NO-B')
  try:n['finalize'](args,checked)
  except ValueError as e:
   assert str(e)==expected,(name,str(e),expected)
   results.append({'name':name,'args':vars(args),'exception_type':type(e).__name__,'diagnostic':str(e),'process_calls':len(calls),'B_written':False})
  else:raise AssertionError('accepted '+name)
  assert not calls
  assert not Path(args.macos_root).exists()
 empty=fixtures/'empty-review.json';emptysha=put(empty,{})
 run('empty-review',empty,emptysha,DTO,sha(DTO),'native review identity or verdict differs')
 for state in ('PARTIAL_NONPASS','GAP'):
  dto=copy.deepcopy(original);lane='macos';rb_original=Path(dto['lanes'][lane]['readback']['path']);rb=json.loads(rb_original.read_bytes());rb['state']=state
  rbp=fixtures/(state+'-readback.json');rbsha=put(rbp,rb);dto['lanes'][lane]['readback']={'path':str(rbp),'sha256':rbsha}
  dp=fixtures/(state+'-evidence.json');ds=put(dp,dto)
  pins={}
  for role in ('report','events','prompt'):
   p=fixtures/(state+'-'+role+'.txt');p.write_text('SYNTHETIC PUBLIC TEST ONLY\n');pins[role]={'path':str(p),'sha256':sha(p)}
  review={'schema':1,'state':'PASS','subject':n['SUBJECT'],'product':n['HEAD'],'evidence_sha256':ds,'first_line':f"NATIVE_PUBLIC38_ADEQUATE subject={n['SUBJECT']} product={n['HEAD']} evidence_sha256={ds}",'provenance':{'verified':True,'capabilities':'read-only','events_sha256':pins['events']['sha256'],'prompt_sha256':pins['prompt']['sha256'],**pins}}
  rp=fixtures/(state+'-review.json');rs=put(rp,review)
  run(state,rp,rs,dp,ds,'combined native readback is not explicitly positive')
 # Whole positive path: only process() is substituted; all validation and encoding are real.
 pins={}
 for role in ('report','events','prompt'):
  p=fixtures/('positive-'+role+'.txt');p.write_text('SYNTHETIC PUBLIC TEST ONLY; NOT A REAL REVIEW\n');pins[role]={'path':str(p),'sha256':sha(p)}
 ds=sha(DTO)
 review={'schema':1,'state':'PASS','subject':n['SUBJECT'],'product':n['HEAD'],'evidence_sha256':ds,'first_line':f"NATIVE_PUBLIC38_ADEQUATE subject={n['SUBJECT']} product={n['HEAD']} evidence_sha256={ds}",'provenance':{'verified':True,'capabilities':'read-only','events_sha256':pins['events']['sha256'],'prompt_sha256':pins['prompt']['sha256'],**pins}}
 rp=fixtures/'positive-SYNTHETIC-review.json';rs=put(rp,review)
 args=types.SimpleNamespace(review_receipt=str(rp),review_sha256=rs,native_evidence=str(DTO),native_evidence_sha256=ds,macos_root=str(fixtures/'positive-macos-NO-B'),linux_root='/tmp/SYNTHETIC-positive-linux-NO-B')
 old={'__file__':str(BUILDER),'__name__':'archived_builder'}
 exec(compile((fixtures/'before-freeze_builder.py').read_bytes(),str(fixtures/'before-freeze_builder.py'),'exec'),old)
