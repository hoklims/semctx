 try:old['finalize'](args,checked)
 except KeyError as e:assert e.args==('review_receipt',);red={'exception':'KeyError','diagnostic':str(e),'process_calls':len(calls)}
 else:raise AssertionError('old cycle did not refuse actual noncircular DTO')
 assert not calls
 batches=[];vacancies=[]
 def simulated_process(argv,data=None):
  import base64
  spec=json.loads(data);code=argv[-1]
  if code==g['VACANCY']:
   vacancies.append(spec['root']);return json.dumps({'root':spec['root'],'vacant':True}).encode()
  assert code==g['WRITE'],'unexpected subprocess requested'
