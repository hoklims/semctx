      "axis": "spec",
      "title": "Ordinary JavaScript module-link resolution uses the isolated semantic-dependency filesystem",
      "location": {
        "path": "tools/rust-ts-r0/src/main.rs",
        "line": 876,
        "related_lines": [
          651,
          674,
          890
        ]
