def sha(data):
    return hashlib.sha256(data).hexdigest()


def encode(data, codec):
    if codec == "identity":
        return data
    result = io.BytesIO()
    with gzip.GzipFile(fileobj=result, mode="wb", filename="", mtime=0, compresslevel=9) as stream:
        stream.write(data)
    return result.getvalue()


def safe_relative(value):
    if type(value) is not str or not value or "\\" in value or ":" in value or any(ord(c) < 32 for c in value):
        raise ValueError("unsafe path")
    path = PurePosixPath(value)
    if path.is_absolute() or path.as_posix() != value or any(p in (".", "..") or p.endswith((".", " ")) for p in path.parts):
        raise ValueError("noncanonical path")
    return path


def no_alias(path):
    if path.absolute() != path.resolve() or any(p.is_symlink() or p.is_junction() for p in (path, *path.parents)):
        raise ValueError("alias refused")


def validate(source_root, manifest, manifest_sha, output):
    if output.exists() or output.is_symlink():
        raise FileExistsError("new output required")
    no_alias(source_root)
    no_alias(manifest)
    no_alias(output.parent)
    if not output.parent.is_dir() or output == source_root or output in source_root.parents:
        raise ValueError("invalid output")
    raw = manifest.read_bytes()
    if sha(raw) != manifest_sha:
        raise ValueError("external manifest pin mismatch")
    data = json.loads(raw)
    if data.get("schema_version") != 1 or type(data.get("schema_version")) is not int or data.get("kind") != "FINITE_WINDOWS_TRANSPORT_PUBLIC_ASSETS" or data.get("source_head") != "96fedbbe14e8585ae1c89e2656604bf5ecabf2c3":
        raise ValueError("manifest identity mismatch")
    rows = data["assets"]
    if type(rows) is not list or len(rows) != len(ALLOWED):
        raise ValueError("finite asset count mismatch")
    seen = set()
    destinations = set()
    encoded = []
    for row in rows:
        source_key = safe_relative(row["source_path"]).as_posix()
        logical = safe_relative(row["logical_path"]).as_posix()
        stored = safe_relative(row["stored_path"]).as_posix()
        if source_key in seen or stored.casefold() in destinations or ALLOWED.get(source_key) != (logical, stored, row["codec"]):
            raise ValueError("asset outside literal public allowlist")
        if row["codec"] == "gzip" and Path(source_key).suffix in (".gz", ".zip", ".xz", ".bz2"):
            raise ValueError("recompression of archive refused")
        source = source_root / source_key
        no_alias(source)
        payload = source.read_bytes()
        if type(row["decoded_bytes"]) is not int or len(payload) != row["decoded_bytes"] or sha(payload) != row["decoded_sha256"]:
            raise ValueError("source pin mismatch")
        result = encode(payload, row["codec"])
        if type(row["stored_bytes"]) is not int or len(result) != row["stored_bytes"] or sha(result) != row["stored_sha256"]:
            raise ValueError("encoded pin mismatch")
        if (gzip.decompress(result) if row["codec"] == "gzip" else result) != payload:
            raise ValueError("decode mismatch")
        seen.add(source_key)
        destinations.add(stored.casefold())
        encoded.append((row, result))
    if seen != set(ALLOWED):
        raise ValueError("incomplete public asset set")
    return raw, encoded


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--source-root", required=True, type=Path)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--manifest-sha256", required=True)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--validate-only", action="store_true")
    args = parser.parse_args()
    output = args.output.absolute()
    raw, encoded = validate(args.source_root.absolute(), args.manifest.absolute(), args.manifest_sha256, output)
    if args.validate_only:
        print(json.dumps({"state": "VALIDATED_NO_OUTPUT_CREATED", "assets": len(encoded)}))
        return
    output.mkdir(exist_ok=False)
    for row, result in encoded:
        target = output / row["stored_path"]
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open("xb") as stream:
            stream.write(result)
        actual = target.read_bytes()
        decoded = gzip.decompress(actual) if row["codec"] == "gzip" else actual
        if sha(actual) != row["stored_sha256"] or sha(decoded) != row["decoded_sha256"] or len(decoded) != row["decoded_bytes"]:
            raise ValueError("published readback mismatch; partial output retained")
    with (output / "additional-publication-manifest.json").open("xb") as stream:
        stream.write(raw)
    print(json.dumps({"state": "COPIED_PUBLIC_ASSETS_ONLY", "assets": len(encoded), "qualification_credit": 0, "R0_decision": None}))


if __name__ == "__main__":
    main()
