const calls=[];
function walk(n){if(ts.isCallExpression(n)){
 const symbol=checker.getSymbolAtLocation(n.expression);if(!symbol)throw Error('checker symbol absent');
 calls.push({call:node(n),text:n.getText(sf),expression:node(n.expression),symbol:{name:symbol.getName(),valueDeclaration:symbol.valueDeclaration?node(symbol.valueDeclaration):null,declarations:(symbol.getDeclarations()||[]).map(node)}});
}ts.forEachChild(n,walk);}walk(sf);
const extraction=production.extractTypeScript(request.roots,request.cwd,new Map(Object.entries(request.files)));
if(calls.length!==1||extraction.calls.length!==1)throw Error('one-call public witness required');
