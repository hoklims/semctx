const texts=new Map(Object.entries({...request.files,...sdk.files}).map(([p,t])=>[norm(p),t]));
const options={target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext,moduleResolution:ts.ModuleResolutionKind.Bundler,allowJs:true,jsx:ts.JsxEmit.Preserve,skipLibCheck:true,noEmit:true,strict:false,types:[]};
